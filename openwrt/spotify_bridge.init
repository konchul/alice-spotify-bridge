#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

USB_ROOTFS="/mnt/usb/noble_rootfs.tar.gz"
CHROOT_DIR="/tmp/noble"

mount_chroot() {
    # 1. Mount tmpfs if needed
    if ! grep -qs "$CHROOT_DIR " /proc/mounts; then
        mkdir -p "$CHROOT_DIR"
        mount -t tmpfs -o size=2048M,mode=755 tmpfs "$CHROOT_DIR"
    fi

    # 2. Extract rootfs if not present
    if [ ! -f "$CHROOT_DIR/usr/bin/python3" ]; then
        if [ -f "$USB_ROOTFS" ]; then
            tar -xzf "$USB_ROOTFS" -C "$CHROOT_DIR"
        fi
    fi

    # 3. Always ensure latest bridge code and config are synced from USB
    if [ -f "/mnt/usb/bridge.py" ]; then
        cp "/mnt/usb/bridge.py" "$CHROOT_DIR/root/bridge.py"
    fi
    if [ -f "/mnt/usb/config.json" ]; then
        cp "/mnt/usb/config.json" "$CHROOT_DIR/root/config.json"
    fi

    # 4. Mount virtual filesystems
    mkdir -p "$CHROOT_DIR/proc" "$CHROOT_DIR/sys" "$CHROOT_DIR/dev" "$CHROOT_DIR/dev/pts" "$CHROOT_DIR/tmp"
    grep -qs "$CHROOT_DIR/proc " /proc/mounts || mount -t proc proc "$CHROOT_DIR/proc"
    grep -qs "$CHROOT_DIR/sys " /proc/mounts || mount -t sysfs sysfs "$CHROOT_DIR/sys"
    grep -qs "$CHROOT_DIR/dev " /proc/mounts || mount -t tmpfs -o size=512k,mode=755 tmpfs "$CHROOT_DIR/dev"
    grep -qs "$CHROOT_DIR/dev/pts " /proc/mounts || mount -t devpts devpts "$CHROOT_DIR/dev/pts"

    # Ensure device nodes
    [ -c "$CHROOT_DIR/dev/urandom" ] || mknod "$CHROOT_DIR/dev/urandom" c 1 9
    [ -c "$CHROOT_DIR/dev/null" ] || mknod "$CHROOT_DIR/dev/null" c 1 3
    [ -c "$CHROOT_DIR/dev/zero" ] || mknod "$CHROOT_DIR/dev/zero" c 1 5
    chmod 666 "$CHROOT_DIR/dev/urandom" "$CHROOT_DIR/dev/null" "$CHROOT_DIR/dev/zero" 2>/dev/null

    # Ensure FIFOs
    [ -p "$CHROOT_DIR/tmp/shairport-sync-audio" ] || mkfifo "$CHROOT_DIR/tmp/shairport-sync-audio"
    [ -p "$CHROOT_DIR/tmp/shairport-sync-metadata" ] || mkfifo "$CHROOT_DIR/tmp/shairport-sync-metadata"
    chmod 666 "$CHROOT_DIR/tmp/shairport-sync-audio" "$CHROOT_DIR/tmp/shairport-sync-metadata" 2>/dev/null
}

start_service() {
    mount_chroot

    # Ensure PulseAudio is active in chroot
    if ! chroot "$CHROOT_DIR" pactl info >/dev/null 2>&1; then
        chroot "$CHROOT_DIR" pulseaudio -D --exit-idle-time=-1 --disallow-exit=1
        sleep 1
    fi

    # Soloist Spotify Connect
    procd_open_instance soloist
    procd_set_param command env -u LD_PRELOAD chroot "$CHROOT_DIR" /root/run_soloist.sh
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance

    # Bridge service
    procd_open_instance bridge
    procd_set_param command env -u LD_PRELOAD chroot "$CHROOT_DIR" python3 -u /root/bridge.py
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    pkill -f /root/bridge.py 2>/dev/null
    pkill -f /usr/local/bin/soloist 2>/dev/null
    pkill -f pacat 2>/dev/null
}
